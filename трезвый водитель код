import json
import ssl
import urllib.request
import urllib.parse
import time

TOKEN = "8099391152:AAG4UDErsqzn7cg7psJgcZEX_Hbb_5N8GcA"
API_URL = f"https://api.telegram.org/bot{TOKEN}/"

ADMIN_CHAT_ID = "7465925576"  # Твой Telegram ID

ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

def api(method, data):
    url = API_URL + method
    data = urllib.parse.urlencode(data).encode()
    req = urllib.request.Request(url, data=data)
    with urllib.request.urlopen(req, context=ctx) as r:
        return json.load(r)

def get_updates(offset=None):
    return api("getUpdates", {"offset": offset, "timeout": 30})

def send_message(chat_id, text, reply_markup=None):
    data = {
        "chat_id": chat_id,
        "text": text,
        "parse_mode": "HTML"
    }
    if reply_markup:
        data["reply_markup"] = json.dumps(reply_markup)
    return api("sendMessage", data)

def get_contact_buttons():
    return {
        "keyboard": [
            [{"text": "📍 Поделиться геолокацией", "request_location": True}],
            [{"text": "📞 Позвонить", "url": "tel:+971582615619"}],
            [{"text": "💬 WhatsApp", "url": "https://wa.me/971582615619"}],
        ],
        "resize_keyboard": True,
        "one_time_keyboard": True
    }

def main():
    print("✅ Бот запущен")
    offset = None
    while True:
        try:
            updates = get_updates(offset)
            for update in updates.get("result", []):
                offset = update["update_id"] + 1
                if "message" in update:
                    message = update["message"]
                    chat_id = message["chat"]["id"]
                    text = message.get("text", "")
                    name = message["chat"].get("first_name", "Пользователь")
                    
                    # Приветствие и автоответ клиенту
                    if text == "/start":
                        reply = (
                            "🚘 <b>Трезвый водитель в Дубае</b>\n\n"
                            "🇷🇺 Нажмите кнопку ниже, чтобы поделиться геолокацией или связаться с нами.\n"
                            "🇬🇧 Press the button below to share location or contact us."
                        )
                        send_message(chat_id, reply, reply_markup=get_contact_buttons())
                    else:
                        # Ответ на обычное сообщение
                        confirmation = (
                            f"✅ <b>Ваш заказ принят</b>\n"
                            f"Ожидайте, с вами скоро свяжутся.\n\n"
                            f"✅ <b>Your request is accepted</b>\n"
                            f"Our driver will contact you shortly."
                        )
                        send_message(chat_id, confirmation)

                        # Уведомление админу
                        notify = f"📲 Новый заказ от @{message['chat'].get('username', 'без username')} ({name})\nСообщение: {text}"
                        send_message(ADMIN_CHAT_ID, notify)

                # Если отправлена геолокация
                if "location" in update.get("message", {}):
                    location = update["message"]["location"]
                    lat = location["latitude"]
                    lon = location["longitude"]
                    user = update["message"]["chat"]
                    send_message(ADMIN_CHAT_ID, f"📍 Геолокация от {user.get('first_name', 'Пользователь')}:\nhttps://www.google.com/maps?q={lat},{lon}")
        except Exception as e:
            print("⚠️ Ошибка:", e)
            time.sleep(5)

if __name__ == "__main__":
    main()
